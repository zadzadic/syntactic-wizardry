@@ -0,0 +1,21 @@
+package com.proxpero.syntacticwizardry;
+
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.Level;
+
+/** A village Delver. Uses the standard Gnome model with a real iron pickaxe. */
+public final class GnomeDelverEntity extends GnomeEntity {
+    public GnomeDelverEntity(EntityType<? extends GnomeDelverEntity> type, Level level) {
+        super(type, level);
+    }
+
+    @Override public void aiStep() {
+        super.aiStep();
+        if (!level().isClientSide() && !getMainHandItem().is(Items.IRON_PICKAXE)) {
+            setItemSlot(EquipmentSlot.MAINHAND, new ItemStack(Items.IRON_PICKAXE));
+        }
+    }
+}
