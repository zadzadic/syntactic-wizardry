--- /dev/null
+++ b/src/main/java/com/proxpero/syntacticwizardry/GnomeVillageData.java
@@ -0,0 +1,184 @@
+package com.proxpero.syntacticwizardry;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.HolderLookup;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.ListTag;
+import net.minecraft.nbt.Tag;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.datafix.DataFixTypes;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.saveddata.SavedData;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+/** Persistent village membership, exclusive workstation ownership, and foreign block tracking. */
+public final class GnomeVillageData extends SavedData {
+    private static final String DATA_NAME = "syntacticwizardry_gnome_villages_v1";
+    // Until world generation supplies explicit boundaries, use a finite area around the saved village home.
+    public static final int RADIUS = 24;
+    public static final int HEIGHT = 12;
+
+    public record Resident(UUID village, boolean elder, BlockPos home) {}
+    public record Claim(UUID village, UUID owner, String profession, BlockPos pos, int stateId) {}
+    public record ForeignBlock(UUID village, BlockPos pos, int stateId) {}
+
+    private final Map<UUID, Resident> members = new HashMap<>();
+    private final Map<UUID, Claim> claims = new HashMap<>();
+    private final Map<UUID, Map<Long, ForeignBlock>> foreignBlocks = new HashMap<>();
+    private final Map<UUID, Scan> scans = new HashMap<>();
+    private record Scan(long time, BlockPos home, List<BlockPos> anvils, List<BlockPos> composters) {}
+
+    public static Factory<GnomeVillageData> factory() {
+        return new Factory<>(GnomeVillageData::new, GnomeVillageData::load, DataFixTypes.SAVED_DATA_COMMAND_STORAGE);
+    }
+    public static GnomeVillageData get(ServerLevel level) {
+        return level.getDataStorage().computeIfAbsent(factory(), DATA_NAME);
+    }
+    public static GnomeVillageData load(CompoundTag root, HolderLookup.Provider registries) {
+        GnomeVillageData data = new GnomeVillageData();
+        ListTag residents = root.getList("Residents", Tag.TAG_COMPOUND);
+        for (int i = 0; i < residents.size(); i++) {
+            CompoundTag tag = residents.getCompound(i);
+            if (!tag.hasUUID("Id") || !tag.hasUUID("Village")) continue;
+            data.members.put(tag.getUUID("Id"), new Resident(tag.getUUID("Village"),
+                    tag.getBoolean("Elder"), BlockPos.of(tag.getLong("Home"))));
+        }
+        ListTag work = root.getList("Workstations", Tag.TAG_COMPOUND);
+        for (int i = 0; i < work.size(); i++) {
+            CompoundTag tag = work.getCompound(i);
+            if (!tag.hasUUID("Owner") || !tag.hasUUID("Village")) continue;
+            UUID owner = tag.getUUID("Owner");
+            data.claims.put(owner, new Claim(tag.getUUID("Village"), owner,
+                    tag.getString("Profession"), BlockPos.of(tag.getLong("Pos")), tag.getInt("State")));
+        }
+        ListTag placed = root.getList("ForeignBlocks", Tag.TAG_COMPOUND);
+        for (int i = 0; i < placed.size(); i++) {
+            CompoundTag tag = placed.getCompound(i);
+            if (!tag.hasUUID("Village")) continue;
+            UUID village = tag.getUUID("Village");
+            ForeignBlock block = new ForeignBlock(village, BlockPos.of(tag.getLong("Pos")), tag.getInt("State"));
+            data.foreignBlocks.computeIfAbsent(village, unused -> new HashMap<>()).put(block.pos().asLong(), block);
+        }
+        return data;
+    }
+    @Override public CompoundTag save(CompoundTag root, HolderLookup.Provider registries) {
+        ListTag residents = new ListTag();
+        for (Map.Entry<UUID, Resident> entry : members.entrySet()) {
+            CompoundTag tag = new CompoundTag();
+            tag.putUUID("Id", entry.getKey()); tag.putUUID("Village", entry.getValue().village());
+            tag.putBoolean("Elder", entry.getValue().elder()); tag.putLong("Home", entry.getValue().home().asLong());
+            residents.add(tag);
+        }
+        root.put("Residents", residents);
+        ListTag work = new ListTag();
+        for (Claim c : claims.values()) {
+            CompoundTag tag = new CompoundTag(); tag.putUUID("Owner", c.owner());
+            tag.putUUID("Village", c.village()); tag.putString("Profession", c.profession());
+            tag.putLong("Pos", c.pos().asLong()); tag.putInt("State", c.stateId()); work.add(tag);
+        }
+        root.put("Workstations", work);
+        ListTag placed = new ListTag();
+        for (Map<Long, ForeignBlock> blocks : foreignBlocks.values()) for (ForeignBlock b : blocks.values()) {
+            CompoundTag tag = new CompoundTag(); tag.putUUID("Village", b.village());
+            tag.putLong("Pos", b.pos().asLong()); tag.putInt("State", b.stateId()); placed.add(tag);
+        }
+        root.put("ForeignBlocks", placed);
+        return root;
+    }
+    public static boolean inside(BlockPos pos, BlockPos home) {
+        return Math.abs(pos.getX() - home.getX()) <= RADIUS
+                && Math.abs(pos.getY() - home.getY()) <= HEIGHT
+                && Math.abs(pos.getZ() - home.getZ()) <= RADIUS;
+    }
+    public void register(UUID id, UUID village, boolean elder, BlockPos home) {
+        Resident previous = members.get(id);
+        Resident now = new Resident(village, elder, home);
+        if (!now.equals(previous)) { members.put(id, now); setDirty(); }
+    }
+    public void retire(UUID id) {
+        if (members.remove(id) != null) setDirty();
+        if (claims.remove(id) != null) setDirty();
+    }
+    public int count(UUID village, boolean elder) {
+        int result = 0;
+        for (Resident member : members.values()) if (village.equals(member.village()) && member.elder() == elder) result++;
+        return result;
+    }
+    public Claim claimFor(UUID id) { return claims.get(id); }
+    private boolean taken(UUID village, BlockPos pos) {
+        for (Claim c : claims.values()) if (village.equals(c.village()) && c.pos().equals(pos)) return true;
+        return false;
+    }
+    public Claim claim(UUID village, UUID owner, String profession, BlockPos pos, BlockState state) {
+        Claim old = claims.get(owner);
+        if (old != null || taken(village, pos)) return old;
+        Claim c = new Claim(village, owner, profession, pos.immutable(), Block.getId(state));
+        claims.put(owner, c); setDirty(); return c;
+    }
+    private Scan scan(ServerLevel level, UUID village, BlockPos home) {
+        Scan cached = scans.get(village);
+        long now = level.getGameTime();
+        if (cached != null && cached.home().equals(home) && now - cached.time() < 100) return cached;
+        List<BlockPos> anvils = new ArrayList<>(), composters = new ArrayList<>();
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+        for (int dx = -RADIUS; dx <= RADIUS; dx++) for (int dz = -RADIUS; dz <= RADIUS; dz++) {
+            for (int dy = -HEIGHT; dy <= HEIGHT; dy++) {
+                pos.set(home.getX()+dx, home.getY()+dy, home.getZ()+dz);
+                if (!level.isLoaded(pos)) continue;
+                BlockState state = level.getBlockState(pos);
+                if (state.is(Blocks.ANVIL) || state.is(Blocks.CHIPPED_ANVIL) || state.is(Blocks.DAMAGED_ANVIL))
+                    anvils.add(pos.immutable());
+                else if (state.is(Blocks.COMPOSTER)) composters.add(pos.immutable());
+            }
+        }
+        Scan result = new Scan(now, home.immutable(), anvils, composters);
+        scans.put(village, result); return result;
+    }
+    public Claim findAndClaim(ServerLevel level, UUID village, UUID owner, BlockPos home, BlockPos gnome) {
+        Claim current = claims.get(owner);
+        if (current != null) return current;
+        Scan available = scan(level, village, home);
+        // Smiths get first refusal on anvils. Next unassigned residents may become Growers.
+        for (String role : List.of("smith", "grower")) {
+            List<BlockPos> positions = new ArrayList<>(role.equals("smith") ? available.anvils() : available.composters());
+            positions.sort(Comparator.comparingDouble(pos -> pos.distSqr(gnome)));
+            for (BlockPos pos : positions) {
+                if (taken(village, pos) || !level.isLoaded(pos)) continue;
+                BlockState state = level.getBlockState(pos);
+                if ((role.equals("smith") && !(state.is(Blocks.ANVIL) || state.is(Blocks.CHIPPED_ANVIL) || state.is(Blocks.DAMAGED_ANVIL)))
+                        || (role.equals("grower") && !state.is(Blocks.COMPOSTER))) continue;
+                return claim(village, owner, role, pos, state);
+            }
+        }
+        return null;
+    }
+    public void recordForeignBlock(ServerLevel level, BlockPos pos) {
+        // Only players and Endermen trigger this method. Village-placed blocks are never recorded.
+        for (Resident member : members.values()) {
+            UUID village = member.village();
+            if (!inside(pos, member.home())) continue;
+            Map<Long, ForeignBlock> blocks = foreignBlocks.computeIfAbsent(village, unused -> new HashMap<>());
+            blocks.put(pos.asLong(), new ForeignBlock(village, pos.immutable(), Block.getId(level.getBlockState(pos))));
+            setDirty();
+        }
+    }
+    public ForeignBlock nearestForeign(UUID village, BlockPos from) {
+        Map<Long, ForeignBlock> blocks = foreignBlocks.get(village);
+        if (blocks == null) return null;
+        return blocks.values().stream().min(Comparator.comparingDouble(b -> b.pos().distSqr(from))).orElse(null);
+    }
+    public void clearForeign(UUID village, BlockPos pos) {
+        Map<Long, ForeignBlock> blocks = foreignBlocks.get(village);
+        if (blocks != null && blocks.remove(pos.asLong()) != null) setDirty();
+    }
+}
diff --git a/src/main/java/com/proxpero/syntacticwizardry/GnomeVillagePlacementEvents.java b/src/main/java/com/proxpero/syntacticwizardry/GnomeVillagePlacementEvents.java
