+    private void repairWorkstation(ServerLevel server, GnomeVillageData.Claim claim) {
+        if (getTarget() != null || !server.isLoaded(claim.pos())) return;
+        BlockState existing = server.getBlockState(claim.pos());
+        boolean correct = PROFESSION_SMITH.equals(claim.profession())
+                ? existing.is(Blocks.ANVIL) || existing.is(Blocks.CHIPPED_ANVIL) || existing.is(Blocks.DAMAGED_ANVIL)
+                : existing.is(Blocks.COMPOSTER);
+        if (correct || !existing.isAir()) return; // Occupied: let a Delver remove the obstruction.
+        if (blockPosition().distSqr(claim.pos()) > 9) {
+            getNavigation().moveTo(claim.pos().getX() + .5, claim.pos().getY(), claim.pos().getZ() + .5, 0.8D);
+            return;
+        }
