     public static int[] plan(ItemStack stack) { return data(stack).getIntArray(PLAN); }
     public static int[] settings(ItemStack stack) { return data(stack).getIntArray(SETTINGS); }
 
+    private static void setAmount(ItemStack stack, int amount) {
+        CustomData.update(DataComponents.CUSTOM_DATA, stack, tag -> tag.putInt(AMOUNT, Math.max(0, amount)));
+    }
+
+    @Override
+    public InteractionResult useOn(UseOnContext context) {
+        if (!context.getLevel().getBlockState(context.getClickedPos()).is(Blocks.CAULDRON)
+                && !context.getLevel().getBlockState(context.getClickedPos()).is(Blocks.WATER_CAULDRON)) {
+            return InteractionResult.PASS;
+        }
+        if (context.getLevel().isClientSide()) return InteractionResult.SUCCESS;
+        if (!(context.getLevel() instanceof ServerLevel server)) return InteractionResult.PASS;
+
+        ItemStack stack = context.getItemInHand();
+        int stored = amount(stack);
+        if (stored <= 0) return InteractionResult.FAIL;
+
+        int moved = AlchemyBrewingService.fillPotionCauldron(server, context.getClickedPos(), stored, plan(stack), settings(stack));
+        if (moved <= 0) {
+            Player player = context.getPlayer();
+            if (player != null) player.displayClientMessage(Component.literal("That cauldron cannot accept this potion."), true);
+            return InteractionResult.FAIL;
+        }
+
+        Player player = context.getPlayer();
+        if (player == null || !player.getAbilities().instabuild) {
+            int remaining = stored - moved;
+            if (remaining <= 0) {
+                if (player != null) player.setItemInHand(context.getHand(), new ItemStack(Items.BUCKET));
+                else stack.shrink(1);
+            } else {
+                setAmount(stack, remaining);
+            }
+        }
+        if (player != null) player.displayClientMessage(Component.literal("Poured " + moved + " mB of potion into the cauldron."), true);
+        return InteractionResult.SUCCESS;
+    }
+
