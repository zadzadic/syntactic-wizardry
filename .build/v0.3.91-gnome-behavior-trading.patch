+package com.proxpero.syntacticwizardry;
+
+import java.util.EnumSet;
+import java.util.UUID;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.ai.goal.Goal;
+import net.minecraft.world.level.block.Blocks;
+
+/** Daytime profession stations; Delvers still use the original roaming goal. */
+public final class GnomeWorkGoal extends Goal {
+    private final GnomeEntity gnome;
+    private BlockPos anchor;
+    private int nextWalk;
+    private int nextScan;
+
+    public GnomeWorkGoal(GnomeEntity gnome) {
+        this.gnome = gnome;
+        setFlags(EnumSet.of(Flag.MOVE));
+    }
+
+    private boolean available() {
+        return gnome.isAlive() && !gnome.isSleeping() && gnome.getTarget() == null
+                && gnome.getTradingPlayer() == null && gnome.villageId() != null
+                && gnome.level() instanceof ServerLevel server && server.isDay();
+    }
+
+    private BlockPos locate() {
+        if (!(gnome.level() instanceof ServerLevel level)) return null;
+        if (gnome instanceof ElderGnomeEntity) {
+            // Upper gallery, Y+10. The central shaft must remain unobstructed.
+            BlockPos home = gnome.villageHome();
+            BlockPos[] gallery = {home.offset(9, 11, 0), home.offset(0, 11, 9),
+                    home.offset(-9, 11, 0), home.offset(0, 11, -9)};
+            for (BlockPos spot : gallery) {
+                if (level.isLoaded(spot) && level.getBlockState(spot).isAir()
+                        && level.getBlockState(spot.above()).isAir()
+                        && level.getBlockState(spot.below()).isSolid()) return spot;
+            }
+            return home.above(11);
+        }
+        UUID village = gnome.villageId();
+        GnomeVillageData.Claim claim = GnomeVillageData.get(level).claimFor(gnome.getUUID());
+        if (claim == null || !village.equals(claim.village())) return null;
+        if ("smith".equals(claim.profession())) return claim.pos().south(2);
+        if (!"grower".equals(claim.profession())) return null;
+        // Move among the mushrooms rather than staying on top of the Composter.
+        BlockPos base = claim.pos();
+        BlockPos result = base.south(2);
+        double best = Double.MAX_VALUE;
+        for (BlockPos pos : BlockPos.betweenClosed(base.offset(-9, -2, -9), base.offset(9, 2, 9))) {
+            if (!level.isLoaded(pos)) continue;
+            if (!(level.getBlockState(pos).is(Blocks.RED_MUSHROOM)
+                    || level.getBlockState(pos).is(Blocks.BROWN_MUSHROOM))) continue;
+            BlockPos foot = pos.immutable();
+            BlockPos candidate = foot.north();
+            if (!level.getBlockState(candidate).isAir() || !level.getBlockState(candidate.above()).isAir()
+                    || !level.getBlockState(candidate.below()).isSolid()) continue;
+            double dist = base.distSqr(candidate);
+            if (dist < best) { best = dist; result = candidate; }
+        }
+        return result;
+    }
+
+    @Override public boolean canUse() {
+        if (!available()) return false;
+        if (!(gnome instanceof ElderGnomeEntity)
+                && !"smith".equals(gnome.gnomeProfession())
+                && !"grower".equals(gnome.gnomeProfession())) return false;
+        anchor = locate();
+        return anchor != null;
+    }
+
+    @Override public boolean canContinueToUse() { return available() && anchor != null; }
+
+    @Override public void start() { nextWalk = 0; nextScan = 0; }
+
+    @Override public void tick() {
+        if (--nextScan <= 0) {
+            nextScan = 200;
+            BlockPos updated = locate();
+            if (updated != null) anchor = updated;
+        }
+        if (anchor == null) return;
+        int range = gnome instanceof ElderGnomeEntity ? 6 : "smith".equals(gnome.gnomeProfession()) ? 5 : 7;
+        double distance = gnome.blockPosition().distSqr(anchor);
+        if (distance > range * range || --nextWalk <= 0) {
+            nextWalk = 80 + gnome.getRandom().nextInt(100);
+            BlockPos destination = anchor;
+            if (distance <= range * range) {
+                for (int attempt = 0; attempt < 10; attempt++) {
+                    BlockPos trial = anchor.offset(gnome.getRandom().nextInt(range * 2 + 1) - range,
+                            0, gnome.getRandom().nextInt(range * 2 + 1) - range);
+                    if (gnome.level().getBlockState(trial).isAir()
+                            && gnome.level().getBlockState(trial.above()).isAir()
+                            && gnome.level().getBlockState(trial.below()).isSolid()) {
+                        destination = trial;
+                        break;
+                    }
+                }
+            }
+            gnome.getNavigation().moveTo(destination.getX() + .5, destination.getY(),
+                    destination.getZ() + .5, .8D);
+        }
+    }
+
+    @Override public void stop() { anchor = null; gnome.getNavigation().stop(); }
+}
