--- a/src/main/java/com/proxpero/syntacticwizardry/GeomanticNodeBlock.java
+++ b/src/main/java/com/proxpero/syntacticwizardry/GeomanticNodeBlock.java
@@ -31,23 +31,28 @@ public final class GeomanticNodeBlock extends Block implements EntityBlock {
     @Override public VoxelShape getCollisionShape(BlockState state, BlockGetter level, BlockPos pos, CollisionContext context) { return Shapes.empty(); }
     @Override public BlockEntity newBlockEntity(BlockPos pos, BlockState state) { return new GeomanticNodeBlockEntity(pos, state); }
 
+    /** Permanently consume this node and award the first successful attunement. */
+    public static void attune(ServerPlayer player, Level level, BlockPos pos) {
+        if (level.isClientSide()) return;
+        if (!ManaService.isUnlocked(player)) {
+            player.displayClientMessage(Component.literal("You must be Awakened to commune with a Geomantic Node."), true);
+            return;
+        }
+        // Remove the block BEFORE granting the reward. A consumed node cannot be
+        // activated a second time, by this player or by anyone else.
+        if (!level.getBlockState(pos).is(GeomanticNodeRegistry.block())
+                || !level.removeBlock(pos, false)) return;
+        ManaService.setMaxManaBonus(player, ManaService.getMaxManaBonus(player) + 5.0F);
+        ArcaneResearchProgress.grantKnowledge(player, 1);
+        player.displayClientMessage(Component.literal("Geomantic attunement: +5 maximum Mana, +1 Arcane Knowledge. The Node is consumed."), false);
+    }
+
     @Override protected ItemInteractionResult useItemOn(ItemStack stack, BlockState state, Level level,
             BlockPos pos, Player player, InteractionHand hand, BlockHitResult hit) {
         if (!stack.is(SyntacticWizardry.WAND.get())) return ItemInteractionResult.PASS_TO_DEFAULT_BLOCK_INTERACTION;
         if (level.isClientSide()) return ItemInteractionResult.SUCCESS;
         if (!(player instanceof ServerPlayer serverPlayer)) return ItemInteractionResult.FAIL;
-        if (!ManaService.isUnlocked(serverPlayer)) {
-            serverPlayer.displayClientMessage(Component.literal("You must be Awakened to commune with a Geomantic Node."), true);
-            return ItemInteractionResult.SUCCESS;
-        }
-        if (!(level.getBlockEntity(pos) instanceof GeomanticNodeBlockEntity node)) return ItemInteractionResult.FAIL;
-        if (!node.claim(serverPlayer.getUUID())) {
-            serverPlayer.displayClientMessage(Component.literal("You have already drawn knowledge from this Geomantic Node."), true);
-            return ItemInteractionResult.SUCCESS;
-        }
-        ManaService.setMaxManaBonus(serverPlayer, ManaService.getMaxManaBonus(serverPlayer) + 5.0F);
-        ArcaneResearchProgress.grantKnowledge(serverPlayer, 1);
-        serverPlayer.displayClientMessage(Component.literal("Geomantic attunement: +5 maximum Mana, +1 Arcane Knowledge."), false);
+        attune(serverPlayer, level, pos);
         return ItemInteractionResult.SUCCESS;
     }
 }
