+        private Cavern findNaturalCavern() {
+            Cavern best = null;
+            int bestScore = Integer.MAX_VALUE;
+            for (int x = -20; x <= 20; x++) for (int z = -20; z <= 20; z++) {
+                int radius2 = x*x + z*z;
+                if (radius2 < 14*14 || radius2 > 20*20) continue;
+                // Avoid the existing north-facing galleries and residences.
