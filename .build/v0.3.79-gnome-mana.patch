     @Override public void aiStep() {
         super.aiStep();
         if (!(level() instanceof ServerLevel server) || !isAlive()) return;
+        // Regenerate while alive, regardless of combat state; never exceed max Mana.
+        if (tickCount % 20 == 0) {
+            float currentMana = mana();
+            if (currentMana < MAX_MANA)
+                getPersistentData().putFloat(MANA_KEY,
+                        Math.min(MAX_MANA, currentMana + MANA_REGEN_PER_SECOND));
+        }
         if (!getMainHandItem().is(SyntacticWizardry.IRON_RUNECASTER.get()))
